# LexiGuard Environment Configuration

# Application
APP_NAME=LexiGuard
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=lexiguard_hackathon_super_secret_jwt_key_2026_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Use postgresql+psycopg2://user:pass@localhost:5432/lexiguard for PostgreSQL + pgvector
# Defaults to local SQLite if left empty or set to sqlite:///./lexiguard.db
DATABASE_URL=sqlite:///./lexiguard.db

# Google Gemini API
# Provide your Gemini API Key here. If not provided, LexiGuard runs with realistic legal AI fallbacks.
GEMINI_API_KEY=

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Optional Admin Bootstrap (used by create_admin.py)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=LexiGuard Administrator

